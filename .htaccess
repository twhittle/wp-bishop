# Bishop & Adkins, P.A. — static build only. NOT THE LIVE CONFIGURATION.
#
# The live site runs WordPress. Do not upload this file to the server: it has
# no WordPress rewrite block, so it would break every permalink on the site.
#
# Kept as a reference for the /2026/ redirects and the .well-known rule below.
# Borrow individual lines into the live .htaccess; do not copy the file.
# See DEPLOY.md.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Leave domain validation alone (must stay the FIRST rule) -----------
  # AutoSSL / Let's Encrypt fetch these over plain http to prove domain
  # control. Redirecting them to https on a host whose certificate is not
  # issued yet makes the handshake fail, so the certificate never issues.
  RewriteRule ^\.well-known/ - [L]

  # --- Retire the /2026/ preview path -------------------------------------
  # /2026/            -> /
  # /2026/about.html  -> /about.html
  RewriteRule ^2026/?$ / [R=301,L]
  RewriteRule ^2026/(.+)$ /$1 [R=301,L]

  # --- Canonical host: https + www, matching the <link rel="canonical"> tags
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType text/html               "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header always append X-Frame-Options "SAMEORIGIN"
</IfModule>
